  {
   "fieldname": "port_storage_example",
   "fieldtype": "HTML",
   "options": "<h2>Example</h2>\n<style>\ntable {\n  font-family: arial, sans-serif;\n  border-collapse: collapse;\n  width: 100%;\n}\n\ntd, th {\n  border: 1px solid #dddddd;\n  text-align: left;\n  padding: 8px;\n}\n\n</style>\n\n<table>\n  <tbody>\n  <tr style=\"background-color: #dddddd;\">\n    <th>Charge</th>\n    <th>From</th>\n    <th>To</th>\n  </tr>\n  <tr>\n    <td>Single</td>\n    <td>1</td>\n    <td>7</td>\n  </tr>\n  <tr>\n    <td>Double</td>\n    <td>8</td>\n    <td>9999999</td>\n  </tr>\n</tbody></table>\n"
